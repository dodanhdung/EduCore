}

model InvoiceNumberCounter {
  tenantId  String @map("tenant_id") @db.Uuid
  year      Int
  nextValue BigInt @map("next_value") @db.BigInt
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, year])
  @@map("invoice_number_counters")
}

// Operator-provisioned binding of a dedicated command LOGIN to a verified session.
// No API writer grants; pooled HTTP authentication integration remains R4.
model R2PrincipalBinding {
  databaseRole  String      @id @map("database_role") @db.Text
  authSessionId String      @map("auth_session_id") @db.Uuid
  authSession   AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Restrict)

  @@map("r2_principal_bindings")
}

// Each transfer creates a new enrollment; the prior enrollment remains for history.
model Enrollment {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  studentId             String           @map("student_id") @db.Uuid
  classId               String           @map("class_id") @db.Uuid
  status                EnrollmentStatus
  effectiveFrom         DateTime         @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime?        @map("effective_to") @db.Timestamptz(6)
  priorEnrollmentId     String?          @map("prior_enrollment_id") @db.Uuid
  createdByMembershipId String           @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student              StudentProfile        @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  class                Class                 @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  priorEnrollment      Enrollment?           @relation("EnrollmentLineage", fields: [tenantId, studentId, priorEnrollmentId], references: [tenantId, studentId, id], onDelete: Restrict)
  nextEnrollments      Enrollment[]          @relation("EnrollmentLineage")
  createdBy            TenantMembership      @relation("EnrollmentCreator", fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  sourceTransfers      EnrollmentTransfer[]  @relation("TransferSource")
  targetTransfers      EnrollmentTransfer[]  @relation("TransferTarget")
  sessionParticipants  SessionParticipant[]
  assignmentRecipients AssignmentRecipient[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, id])
  @@unique([tenantId, classId, id])
  @@index([tenantId, classId, status, effectiveFrom])
  @@index([tenantId, studentId, status])
  @@index([tenantId, priorEnrollmentId])
  @@index([tenantId, createdByMembershipId])
  @@map("enrollments")
}

model EnrollmentTransfer {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  sourceEnrollmentId      String   @map("source_enrollment_id") @db.Uuid
  targetClassId           String   @map("target_class_id") @db.Uuid
  effectiveAt             DateTime @map("effective_at") @db.Timestamptz(6)
  status                  String   @db.Text
  targetEnrollmentId      String?  @map("target_enrollment_id") @db.Uuid
  requestedByMembershipId String   @map("requested_by_membership_id") @db.Uuid
  confirmedByMembershipId String?  @map("confirmed_by_membership_id") @db.Uuid
  approvalRequestId       String?  @map("approval_request_id") @db.Uuid
  reason                  String   @db.Text
  operationKey            String   @map("operation_key") @db.Text
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEnrollment Enrollment        @relation("TransferSource", fields: [tenantId, sourceEnrollmentId], references: [tenantId, id], onDelete: Restrict)
  targetClass      Class             @relation(fields: [tenantId, targetClassId], references: [tenantId, id], onDelete: Restrict)
  targetEnrollment Enrollment?       @relation("TransferTarget", fields: [tenantId, targetClassId, targetEnrollmentId], references: [tenantId, classId, id], onDelete: Restrict)
  requestedBy      TenantMembership  @relation("TransferRequester", fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  confirmedBy      TenantMembership? @relation("TransferConfirmer", fields: [tenantId, confirmedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvalRequest  ApprovalRequest?  @relation("TransferApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, sourceEnrollmentId, status])
  @@index([tenantId, targetClassId, status])
  @@index([tenantId, targetEnrollmentId])
  @@index([tenantId, approvalRequestId])
  @@map("enrollment_transfers")
}

model ParentStudentLink {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  parentMembershipId     String    @map("parent_membership_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  relationship           String    @db.Text
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByMembershipId String?   @map("verified_by_membership_id") @db.Uuid
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent     TenantMembership  @relation("ParentLinkParent", fields: [tenantId, parentMembershipId], references: [tenantId, id], onDelete: Restrict)
  student    StudentProfile    @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  verifiedBy TenantMembership? @relation("ParentLinkVerifier", fields: [tenantId, verifiedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, parentMembershipId, revokedAt])
  @@index([tenantId, studentId, revokedAt])
  @@index([tenantId, verifiedByMembershipId])
  @@map("parent_student_links")
}

// A verified sibling pair is explicit evidence, never inferred from shared names or parents.
model VerifiedSiblingRelationship {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  studentAId             String    @map("student_a_id") @db.Uuid
  studentBId             String    @map("student_b_id") @db.Uuid
  verifiedByMembershipId String    @map("verified_by_membership_id") @db.Uuid
  verifiedAt             DateTime  @map("verified_at") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  evidenceNote           String?   @map("evidence_note") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentA   StudentProfile   @relation("SiblingStudentA", fields: [tenantId, studentAId], references: [tenantId, id], onDelete: Restrict)
  studentB   StudentProfile   @relation("SiblingStudentB", fields: [tenantId, studentBId], references: [tenantId, id], onDelete: Restrict)
  verifiedBy TenantMembership @relation("SiblingVerifier", fields: [tenantId, verifiedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, studentAId, revokedAt])
  @@index([tenantId, studentBId, revokedAt])
  @@index([tenantId, verifiedByMembershipId])
  @@map("verified_sibling_relationships")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.Text
  name      String   @db.Text
  capacity  Int
  active    Boolean
  location  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schedulableResource SchedulableResource?
  classSessions       ClassSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("rooms")
}

// Each teacher, student, or room has at most one resource registry row.
model SchedulableResource {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  resourceKind ResourceKind @map("resource_kind")
  teacherId    String?      @map("teacher_id") @db.Uuid
  studentId    String?      @map("student_id") @db.Uuid
  roomId       String?      @map("room_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teacher        TeacherProfile?          @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  student        StudentProfile?          @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  room           Room?                    @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict)
  unavailability ResourceUnavailability[]
  bookings       ResourceBooking[]

  @@unique([tenantId, id])
  @@unique([tenantId, teacherId])
  @@unique([tenantId, studentId])
  @@unique([tenantId, roomId])
  @@map("schedulable_resources")
}

model ResourceUnavailability {
  id                    String                       @id @default(uuid()) @db.Uuid
  tenantId              String                       @map("tenant_id") @db.Uuid
  resourceId            String                       @map("resource_id") @db.Uuid
  startsAt              DateTime                     @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime                     @map("ends_at") @db.Timestamptz(6)
  status                ResourceUnavailabilityStatus
  reason                String                       @db.Text
  createdByMembershipId String                       @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resource  SchedulableResource @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  createdBy TenantMembership    @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  bookings  ResourceBooking[]

  @@unique([tenantId, id])
  @@unique([tenantId, resourceId, id])
  @@index([tenantId, resourceId, status, startsAt])
  @@index([tenantId, createdByMembershipId])
  @@map("resource_unavailability")
}

// A single session leaves seriesId null; weekly series expand to individual sessions.
model ScheduleSeries {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  weekday         Int      @db.SmallInt
  localStartTime  DateTime @map("local_start_time") @db.Time(0)
  durationMinutes Int      @map("duration_minutes")
  validFrom       DateTime @map("valid_from") @db.Date
  validTo         DateTime @map("valid_to") @db.Date
  timezone        String   @db.Text
  status          String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  class    Class          @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  sessions ClassSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, classId, id])
  @@index([tenantId, classId, validFrom])
  @@map("schedule_series")
}

model ClassSession {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  classId         String             @map("class_id") @db.Uuid
  seriesId        String?            @map("series_id") @db.Uuid
  teacherId       String             @map("teacher_id") @db.Uuid
  roomId          String?            @map("room_id") @db.Uuid
  deliveryMode    DeliveryMode       @map("delivery_mode")
  startsAt        DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime           @map("ends_at") @db.Timestamptz(6)
  status          ClassSessionStatus
  cancelReason    String?            @map("cancel_reason") @db.Text
  revision        Int
  policyVersionId String             @map("policy_version_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  class                  Class                   @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  series                 ScheduleSeries?         @relation(fields: [tenantId, classId, seriesId], references: [tenantId, classId, id], onDelete: Restrict)
  teacher                TeacherProfile          @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  room                   Room?                   @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: Restrict)
  policyVersion          PolicyVersion           @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  participants           SessionParticipant[]
  bookings               ResourceBooking[]
  attendanceFinalization AttendanceFinalization?
  priceRules             PriceRule[]
  invoiceLines           InvoiceLine[]

  @@unique([tenantId, id])
  @@index([tenantId, classId, startsAt])
  @@index([tenantId, teacherId, startsAt])
  @@index([tenantId, roomId, startsAt])
  @@index([tenantId, seriesId, startsAt])
  @@index([tenantId, policyVersionId])
  @@map("class_sessions")
}

// Participant identity is unique per session even after removal.
model SessionParticipant {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  sessionId       String                 @map("session_id") @db.Uuid
  studentId       String                 @map("student_id") @db.Uuid
  enrollmentId    String?                @map("enrollment_id") @db.Uuid
  participantKind SessionParticipantKind @map("participant_kind")
  addedAt         DateTime               @default(now()) @map("added_at") @db.Timestamptz(6)
  removedAt       DateTime?              @map("removed_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session          ClassSession                @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  student          StudentProfile              @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  enrollment       Enrollment?                 @relation(fields: [tenantId, studentId, enrollmentId], references: [tenantId, studentId, id], onDelete: Restrict)
  absenceRequests  AbsenceRequest[]
  attendanceRecord AttendanceRecord?
  invoiceLines     InvoiceLine[]
  invoicedClaim    InvoicedParticipationClaim?

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId, id])
  @@unique([tenantId, sessionId, studentId])
  @@unique([tenantId, sessionId, studentId, id], map: "sp_tenant_session_student_id_uq")
  @@index([tenantId, studentId, sessionId])
  @@index([tenantId, enrollmentId])
  @@map("session_participants")
}

// PostgreSQL GiST exclusion on ACTIVE half-open intervals is required for safety.
model ResourceBooking {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  resourceId       String                @map("resource_id") @db.Uuid
  sessionId        String?               @map("session_id") @db.Uuid
  unavailabilityId String?               @map("unavailability_id") @db.Uuid
  startsAt         DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime              @map("ends_at") @db.Timestamptz(6)
  status           ResourceBookingStatus
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resource       SchedulableResource     @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  session        ClassSession?           @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  unavailability ResourceUnavailability? @relation(fields: [tenantId, resourceId, unavailabilityId], references: [tenantId, resourceId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, resourceId, status, startsAt])
  @@index([tenantId, sessionId])
  @@index([tenantId, unavailabilityId])
  @@map("resource_bookings")
}

// Submission timing alone never grants EXCUSED; an authorized decision is required.
model AbsenceRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  participantId          String    @map("participant_id") @db.Uuid
  requesterMembershipId  String    @map("requester_membership_id") @db.Uuid
  submittedAt            DateTime  @map("submitted_at") @db.Timestamptz(6)
  reason                 String    @db.Text
  isLateNotice           Boolean   @map("is_late_notice")
  status                 String    @db.Text
  approvedByMembershipId String?   @map("approved_by_membership_id") @db.Uuid
  decidedAt              DateTime? @map("decided_at") @db.Timestamptz(6)
  approvalRequestId      String?   @map("approval_request_id") @db.Uuid
  policyVersionId        String?   @map("policy_version_id") @db.Uuid
  decisionReason         String?   @map("decision_reason") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  participant     SessionParticipant @relation(fields: [tenantId, participantId], references: [tenantId, id], onDelete: Restrict)
  requester       TenantMembership   @relation("AbsenceRequester", fields: [tenantId, requesterMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvedBy      TenantMembership?  @relation("AbsenceApprover", fields: [tenantId, approvedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvalRequest ApprovalRequest?   @relation("AbsenceApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)
  policyVersion   PolicyVersion?     @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "r3_absence_policy_fk")

  @@unique([tenantId, id])
  @@index([tenantId, participantId, status])
  @@index([tenantId, requesterMembershipId])
  @@index([tenantId, approvedByMembershipId])
  @@index([tenantId, approvalRequestId])
  @@map("absence_requests")
}

// A finalization row exists only after authorized confirmation of the whole session.
model AttendanceFinalization {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  sessionId               String    @map("session_id") @db.Uuid
  confirmedByMembershipId String    @map("confirmed_by_membership_id") @db.Uuid
  confirmedAt             DateTime  @map("confirmed_at") @db.Timestamptz(6)
  lockedAt                DateTime? @map("locked_at") @db.Timestamptz(6)
  revision                Int
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  session     ClassSession       @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  confirmedBy TenantMembership   @relation(fields: [tenantId, confirmedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  records     AttendanceRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, sessionId])
  @@unique([tenantId, sessionId, id], map: "af_tenant_session_id_uq")
  @@index([tenantId, confirmedByMembershipId])
  @@map("attendance_finalizations")
}

// finalizationId null means draft; billing must only read confirmed records.
model AttendanceRecord {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  sessionId              String           @map("session_id") @db.Uuid
  participantId          String           @map("participant_id") @db.Uuid
  finalizationId         String?          @map("finalization_id") @db.Uuid
  attendanceStatus       AttendanceStatus @map("attendance_status")
  recordedByMembershipId String           @map("recorded_by_membership_id") @db.Uuid
  recordedAt             DateTime         @map("recorded_at") @db.Timestamptz(6)
  revision               Int
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  participant  SessionParticipant      @relation(fields: [tenantId, sessionId, participantId], references: [tenantId, sessionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ar_participant_session_fk")
  finalization AttendanceFinalization? @relation(fields: [tenantId, sessionId, finalizationId], references: [tenantId, sessionId, id], onDelete: Restrict, onUpdate: Restrict, map: "ar_finalization_session_fk")
  recordedBy   TenantMembership        @relation(fields: [tenantId, recordedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  corrections  AttendanceCorrection[]
  invoiceLines InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, participantId, id])
  @@unique([tenantId, participantId])
  @@unique([tenantId, sessionId, participantId], map: "ar_tenant_session_participant_uq")
  @@index([tenantId, finalizationId])
  @@index([tenantId, sessionId, finalizationId], map: "ar_tenant_session_finalization_idx")
  @@index([tenantId, recordedByMembershipId])
  @@map("attendance_records")
}

// Append-only correction history; privileged after-lock changes need audit and billing follow-up.
model AttendanceCorrection {
  id                      String           @id @default(uuid()) @db.Uuid
  tenantId                String           @map("tenant_id") @db.Uuid
  attendanceId            String           @map("attendance_id") @db.Uuid
  oldStatus               AttendanceStatus @map("old_status")
  newStatus               AttendanceStatus @map("new_status")
  oldRevision             Int              @map("old_revision")
  newRevision             Int              @map("new_revision")
  previousRecordSnapshot  Json             @map("previous_record_snapshot") @db.JsonB
  reason                  String           @db.Text
  requestedByMembershipId String           @map("requested_by_membership_id") @db.Uuid
  approvedByMembershipId  String?          @map("approved_by_membership_id") @db.Uuid
  correctedAt             DateTime         @map("corrected_at") @db.Timestamptz(6)
  approvalRequestId       String?          @map("approval_request_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attendance      AttendanceRecord  @relation(fields: [tenantId, attendanceId], references: [tenantId, id], onDelete: Restrict)
  requestedBy     TenantMembership  @relation("AttendanceCorrectionRequester", fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvedBy      TenantMembership? @relation("AttendanceCorrectionApprover", fields: [tenantId, approvedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvalRequest ApprovalRequest?  @relation("AttendanceCorrectionApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, attendanceId, newRevision], map: "r3_correction_revision_uq")
  @@index([tenantId, attendanceId, correctedAt])
  @@index([tenantId, requestedByMembershipId])
  @@index([tenantId, approvedByMembershipId])
  @@index([tenantId, approvalRequestId])
  @@map("attendance_corrections")
}

// Effective prices are tenant-local calendar dates; overlap requires PostgreSQL EXCLUDE.
model PriceRule {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  scopeKind             PriceScopeKind @map("scope_kind")
  courseId              String?        @map("course_id") @db.Uuid
  classId               String?        @map("class_id") @db.Uuid
  sessionId             String?        @map("session_id") @db.Uuid
  unitPriceVnd          BigInt         @map("unit_price_vnd") @db.BigInt
  effectiveFrom         DateTime       @map("effective_from") @db.Date
  effectiveTo           DateTime?      @map("effective_to") @db.Date
  policyVersionId       String         @map("policy_version_id") @db.Uuid
  createdByMembershipId String         @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course        Course?          @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  class         Class?           @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  session       ClassSession?    @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  policyVersion PolicyVersion    @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  createdBy     TenantMembership @relation("PriceRuleCreator", fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  invoiceLines  InvoiceLine[]

  @@unique([tenantId, id])
  @@index([tenantId, courseId, effectiveFrom])
  @@index([tenantId, classId, effectiveFrom])
  @@index([tenantId, sessionId, effectiveFrom])
  @@index([tenantId, policyVersionId])
  @@map("price_rules")
}

model BillingPeriod {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  monthStart DateTime @map("month_start") @db.Date
  monthEnd   DateTime @map("month_end") @db.Date
  status     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingRuns BillingRun[]
  invoices    Invoice[]
  generations BillingRunGeneration[]

  @@unique([tenantId, id])
  @@unique([tenantId, monthStart])
  @@map("billing_periods")
}

// One logical run per student and monthly period, even when a draft is recomputed.
model BillingRun {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  periodId                String    @map("period_id") @db.Uuid
  studentId               String    @map("student_id") @db.Uuid
  operationKey            String    @map("operation_key") @db.Text
  state                   String    @db.Text
  policyVersionId         String    @map("policy_version_id") @db.Uuid
  inputSnapshotHash       String    @map("input_snapshot_hash") @db.Text
  computedAt              DateTime? @map("computed_at") @db.Timestamptz(6)
  requestedByMembershipId String?   @map("requested_by_membership_id") @db.Uuid
  errorReason             String?   @map("error_reason") @db.Text
  currentGenerationId     String?   @map("current_generation_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  period            BillingPeriod          @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)
  student           StudentProfile         @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  policyVersion     PolicyVersion          @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  requestedBy       TenantMembership?      @relation("BillingRunRequester", fields: [tenantId, requestedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  invoice           Invoice?
  generations       BillingRunGeneration[] @relation("RunGenerations")
  currentGeneration BillingRunGeneration?  @relation("AppliedGeneration", fields: [tenantId, id, studentId, periodId, currentGenerationId], references: [tenantId, runId, studentId, periodId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, id, studentId, periodId])
  @@unique([tenantId, periodId, studentId])
  @@unique([tenantId, operationKey])
  @@index([tenantId, studentId, state])
  @@index([tenantId, policyVersionId])
  @@map("billing_runs")
}

// The issued header, lines, discounts, and snapshots must be frozen by service/DB policy.
model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  billingRunId         String        @map("billing_run_id") @db.Uuid
  studentId            String        @map("student_id") @db.Uuid
  periodId             String        @map("period_id") @db.Uuid
  invoiceNumber        String?       @map("invoice_number") @db.Text
  status               InvoiceStatus
  financialRevision    BigInt        @default(0) @map("financial_revision") @db.BigInt
  grossVnd             BigInt        @map("gross_vnd") @db.BigInt
  discountVnd          BigInt        @map("discount_vnd") @db.BigInt
  totalVnd             BigInt        @map("total_vnd") @db.BigInt
  issuedAt             DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuedByMembershipId String?       @map("issued_by_membership_id") @db.Uuid
  dueAt                DateTime?     @map("due_at") @db.Timestamptz(6)
  policyVersionId      String        @map("policy_version_id") @db.Uuid
  snapshotJson         Json          @map("snapshot_json") @db.JsonB
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  billingRun        BillingRun                @relation(fields: [tenantId, billingRunId, studentId, periodId], references: [tenantId, id, studentId, periodId], onDelete: Restrict)
  student           StudentProfile            @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  period            BillingPeriod             @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)
  issuedBy          TenantMembership?         @relation("InvoiceIssuer", fields: [tenantId, issuedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  policyVersion     PolicyVersion             @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  lines             InvoiceLine[]
  discounts         InvoiceDiscount[]
  adjustments       InvoiceAdjustment[]
  payments          Payment[]
  allocations       ReceivableAllocation[]
  excessResolutions PaymentExcessResolution[]

  @@unique([tenantId, id])
  @@unique([tenantId, billingRunId])
  @@unique([tenantId, billingRunId, studentId, periodId])
  @@unique([tenantId, id, studentId], map: "inv_tenant_id_student_uq")
  @@unique([tenantId, periodId, studentId])
  // PostgreSQL unique permits multiple NULL draft numbers, but no duplicate issued number.
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, issuedAt])
  @@index([tenantId, studentId, periodId])
  @@map("invoices")
}

model InvoiceLine {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  invoiceId          String   @map("invoice_id") @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  participantId      String   @map("participant_id") @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  attendanceId       String?  @map("attendance_id") @db.Uuid
  priceRuleId        String?  @map("price_rule_id") @db.Uuid
  sourceStatus       String   @map("source_status") @db.Text
  chargeUnits        Int      @map("charge_units") @db.SmallInt
  unitPriceVnd       BigInt   @map("unit_price_vnd") @db.BigInt
  baseAmountVnd      BigInt   @map("base_amount_vnd") @db.BigInt
  reasonCode         String   @map("reason_code") @db.Text
  sourceSnapshotJson Json     @map("source_snapshot_json") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice     Invoice                     @relation(fields: [tenantId, invoiceId, studentId], references: [tenantId, id, studentId], onDelete: Restrict, onUpdate: Restrict, map: "il_invoice_student_fk")
  participant SessionParticipant          @relation(fields: [tenantId, sessionId, studentId, participantId], references: [tenantId, sessionId, studentId, id], onDelete: Restrict, onUpdate: Restrict, map: "il_participant_student_fk")
  session     ClassSession                @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Restrict)
  attendance  AttendanceRecord?           @relation(fields: [tenantId, participantId, attendanceId], references: [tenantId, participantId, id], onDelete: Restrict)
  priceRule   PriceRule?                  @relation(fields: [tenantId, priceRuleId], references: [tenantId, id], onDelete: Restrict)
  claim       InvoicedParticipationClaim?

  @@unique([tenantId, id])
  @@unique([tenantId, participantId, id])
  @@unique([tenantId, invoiceId, participantId])
  @@index([tenantId, sessionId])
  @@index([tenantId, attendanceId])
  @@index([tenantId, priceRuleId])
  @@map("invoice_lines")
}

// P0 permits only the verified sibling discount; COMBO remains outside this schema.
model InvoiceDiscount {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  invoiceId            String              @map("invoice_id") @db.Uuid
  kind                 InvoiceDiscountKind
  sequenceNo           Int                 @map("sequence_no")
  rate                 Decimal             @db.Decimal(6, 5)
  rawDiscountDecimal   Decimal             @map("raw_discount_decimal") @db.Decimal(24, 6)
  evidenceSnapshotJson Json                @map("evidence_snapshot_json") @db.JsonB
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, sequenceNo])
  @@map("invoice_discounts")
}

// An issued participant is claimed once and never silently released after cancellation.
model InvoicedParticipationClaim {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  invoiceLineId String   @map("invoice_line_id") @db.Uuid
  claimedAt     DateTime @map("claimed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  participant SessionParticipant @relation(fields: [tenantId, participantId], references: [tenantId, id], onDelete: Restrict)
  invoiceLine InvoiceLine        @relation(fields: [tenantId, participantId, invoiceLineId], references: [tenantId, participantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, participantId])
  @@unique([tenantId, invoiceLineId])
  @@unique([tenantId, participantId, invoiceLineId])
  @@map("invoiced_participation_claims")
}

// Applied adjustments never rewrite the issued invoice amount or lines.
model InvoiceAdjustment {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  invoiceId             String                  @map("invoice_id") @db.Uuid
  approvalRequestId     String                  @map("approval_request_id") @db.Uuid
  adjustmentKind        InvoiceAdjustmentKind   @map("adjustment_kind")
  deltaVnd              BigInt                  @map("delta_vnd") @db.BigInt
  reason                String                  @db.Text
  status                InvoiceAdjustmentStatus
  appliedAt             DateTime?               @map("applied_at") @db.Timestamptz(6)
  appliedByMembershipId String?                 @map("applied_by_membership_id") @db.Uuid
  operationKey          String                  @map("operation_key") @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice           Invoice                   @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  appliedBy         TenantMembership?         @relation("AdjustmentApplier", fields: [tenantId, appliedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvalRequest   ApprovalRequest           @relation("InvoiceAdjustmentApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)
  excessResolutions PaymentExcessResolution[]

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, id])
  @@unique([tenantId, operationKey])
  @@unique([tenantId, approvalRequestId], map: "r2_one_adjustment_root")
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, approvalRequestId])
  @@index([tenantId, appliedByMembershipId])
  @@map("invoice_adjustments")
}

// Manually verified payment for exactly one issued invoice; append-only history.
model Payment {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  invoiceId              String        @map("invoice_id") @db.Uuid
  amountVnd              BigInt        @map("amount_vnd") @db.BigInt
  method                 PaymentMethod
  externalReference      String?       @map("external_reference") @db.Text
  paidAt                 DateTime      @map("paid_at") @db.Timestamptz(6)
  recordedByMembershipId String        @map("recorded_by_membership_id") @db.Uuid
  evidenceNote           String?       @map("evidence_note") @db.Text
  idempotencyKey         String        @map("idempotency_key") @db.Text
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice            Invoice                @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  recordedBy         TenantMembership       @relation("PaymentRecorder", fields: [tenantId, recordedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  reversal           PaymentReversal?
  allocations        ReceivableAllocation[]
  walletTransactions WalletTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, invoiceId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId, paidAt])
  @@index([tenantId, recordedByMembershipId])
  @@map("payments")
}

// P0 reversal is full and at most once per payment; no update/delete of Payment.
model PaymentReversal {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  paymentId              String   @map("payment_id") @db.Uuid
  amountVnd              BigInt   @map("amount_vnd") @db.BigInt
  reason                 String   @db.Text
  reversedByMembershipId String   @map("reversed_by_membership_id") @db.Uuid
  reversedAt             DateTime @map("reversed_at") @db.Timestamptz(6)
  approvalRequestId      String?  @map("approval_request_id") @db.Uuid
  operationKey           String   @map("operation_key") @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment         Payment          @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  reversedBy      TenantMembership @relation("PaymentReverser", fields: [tenantId, reversedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation("PaymentReversalApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId])
  @@unique([tenantId, operationKey])
  @@index([tenantId, approvalRequestId])
  @@index([tenantId, reversedByMembershipId])
  @@map("payment_reversals")
}

// P0 allocations have one mandatory payment source; tuition credits remain P1.
model ReceivableAllocation {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  invoiceId           String             @map("invoice_id") @db.Uuid
  paymentId           String             @map("payment_id") @db.Uuid
  amountVnd           BigInt             @map("amount_vnd") @db.BigInt
  kind                String             @default("PAYMENT") @db.Text
  walletTransactionId String?            @unique @map("wallet_transaction_id") @db.Uuid
  walletTransaction   WalletTransaction? @relation(fields: [tenantId, walletTransactionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  allocatedAt         DateTime           @map("allocated_at") @db.Timestamptz(6)
  operationKey        String             @map("operation_key") @db.Text
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  payment Payment @relation(fields: [tenantId, paymentId, invoiceId], references: [tenantId, id, invoiceId], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@unique([tenantId, walletTransactionId])
  @@index([tenantId, invoiceId, allocatedAt])
  @@map("receivable_allocations")
}

// Downward adjustments after payment create a separate pending excess, never auto-credit/refund.
model PaymentExcessResolution {
  id                  String                        @id @default(uuid()) @db.Uuid
  tenantId            String                        @map("tenant_id") @db.Uuid
  invoiceId           String                        @map("invoice_id") @db.Uuid
  triggerAdjustmentId String                        @map("trigger_adjustment_id") @db.Uuid
  amountVnd           BigInt                        @map("amount_vnd") @db.BigInt
  status              PaymentExcessResolutionStatus
  resolutionKind      String?                       @map("resolution_kind") @db.Text
  approvalRequestId   String?                       @map("approval_request_id") @db.Uuid
  reason              String                        @db.Text
  resolvedAt          DateTime?                     @map("resolved_at") @db.Timestamptz(6)
  operationKey        String                        @map("operation_key") @db.Text
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice           Invoice           @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Restrict)
  triggerAdjustment InvoiceAdjustment @relation(fields: [tenantId, invoiceId, triggerAdjustmentId], references: [tenantId, invoiceId, id], onDelete: Restrict)
  approvalRequest   ApprovalRequest?  @relation("PaymentExcessApproval", fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, triggerAdjustmentId])
  @@index([tenantId, approvalRequestId])
  @@map("payment_excess_resolutions")
}

// A class assignment may also target explicitly selected students; recipient rows are the publish snapshot.
model Assignment {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  classId            String?          @map("class_id") @db.Uuid
  createdByTeacherId String           @map("created_by_teacher_id") @db.Uuid
  title              String           @db.Text
  description        String           @db.Text
  priority           Int              @db.SmallInt
  deadlineAt         DateTime         @map("deadline_at") @db.Timestamptz(6)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(6)
  status             AssignmentStatus
  revision           Int
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  class            Class?                @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  createdByTeacher TeacherProfile        @relation(fields: [tenantId, createdByTeacherId], references: [tenantId, id], onDelete: Restrict)
  recipients       AssignmentRecipient[]

  @@unique([tenantId, id])
  @@index([tenantId, classId, status])
  @@index([tenantId, createdByTeacherId, status])
  @@map("assignments")
}

// A revoked recipient is retained; reassigning uses the same row and audit history.
model AssignmentRecipient {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  assignmentId       String    @map("assignment_id") @db.Uuid
  studentId          String    @map("student_id") @db.Uuid
  enrollmentId       String?   @map("enrollment_id") @db.Uuid
  assignedAt         DateTime  @map("assigned_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  deadlineOverrideAt DateTime? @map("deadline_override_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignment Assignment     @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  enrollment Enrollment?    @relation(fields: [tenantId, studentId, enrollmentId], references: [tenantId, studentId, id], onDelete: Restrict)
  submission Submission?

  @@unique([tenantId, id])
  @@unique([tenantId, assignmentId, studentId])
  @@index([tenantId, studentId, revokedAt])
  @@index([tenantId, enrollmentId])
  @@map("assignment_recipients")
}

// Stable container; currentVersionId points only to a version of this submission.
model Submission {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  recipientId      String   @map("recipient_id") @db.Uuid
  currentVersionId String?  @map("current_version_id") @db.Uuid
  status           String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient      AssignmentRecipient @relation(fields: [tenantId, recipientId], references: [tenantId, id], onDelete: Restrict)
  currentVersion SubmissionVersion?  @relation("CurrentSubmissionVersion", fields: [tenantId, id, currentVersionId], references: [tenantId, submissionId, id], onDelete: Restrict)
  versions       SubmissionVersion[] @relation("SubmissionVersions")

  @@unique([tenantId, id])
  @@unique([tenantId, id, currentVersionId])
  @@unique([tenantId, recipientId])
  @@map("submissions")
}

// Append-only answer snapshot. A resubmission creates the next version, never overwrites this row.
model SubmissionVersion {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.Uuid
  submissionId String                  @map("submission_id") @db.Uuid
  versionNo    Int                     @map("version_no")
  submittedAt  DateTime                @map("submitted_at") @db.Timestamptz(6)
  answerText   String?                 @map("answer_text") @db.Text
  isLate       Boolean                 @map("is_late")
  status       SubmissionVersionStatus
  contentHash  String?                 @map("content_hash") @db.Text
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submission           Submission       @relation("SubmissionVersions", fields: [tenantId, submissionId], references: [tenantId, id], onDelete: Restrict)
  currentForSubmission Submission?      @relation("CurrentSubmissionVersion")
  files                SubmissionFile[]
  grades               Grade[]

  @@unique([tenantId, id])
  @@unique([tenantId, submissionId, id])
  @@unique([tenantId, submissionId, versionNo])
  @@index([tenantId, submittedAt])
  @@map("submission_versions")
}

// File bytes live on a private volume; this table stores only ownership and validated metadata.
model StoredFile {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  uploadedByMembershipId String           @map("uploaded_by_membership_id") @db.Uuid
  privateStorageKey      String           @map("private_storage_key") @db.Text
  originalFilename       String           @map("original_filename") @db.Text
  mimeType               String           @map("mime_type") @db.Text
  sizeBytes              BigInt           @map("size_bytes") @db.BigInt
  sha256                 String           @db.Text
  storageStatus          StoredFileStatus @map("storage_status")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  uploadedBy  TenantMembership @relation("FileUploader", fields: [tenantId, uploadedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  submissions SubmissionFile[]

  @@unique([tenantId, id])
  @@unique([tenantId, privateStorageKey])
  @@index([tenantId, uploadedByMembershipId, createdAt])
  @@index([tenantId, storageStatus, createdAt])
  @@map("stored_files")
}

// Links only READY files in the same tenant when a version is finalized under a transaction.
model SubmissionFile {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  submissionVersionId String   @map("submission_version_id") @db.Uuid
  fileId              String   @map("file_id") @db.Uuid
  sortOrder           Int      @map("sort_order") @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submissionVersion SubmissionVersion @relation(fields: [tenantId, submissionVersionId], references: [tenantId, id], onDelete: Restrict)
  file              StoredFile        @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, submissionVersionId, fileId])
  @@index([tenantId, fileId])
  @@map("submission_files")
}

// Published revisions are historical records; a correction creates a new revision with a reason.
model Grade {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  submissionVersionId String      @map("submission_version_id") @db.Uuid
  revisionNo          Int         @map("revision_no")
  score               Decimal     @db.Decimal(3, 1)
  feedback            String?     @db.Text
  gradedByTeacherId   String      @map("graded_by_teacher_id") @db.Uuid
  gradedAt            DateTime    @map("graded_at") @db.Timestamptz(6)
  status              GradeStatus
  publishedAt         DateTime?   @map("published_at") @db.Timestamptz(6)
  reasonForRevision   String?     @map("reason_for_revision") @db.Text
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submissionVersion SubmissionVersion @relation(fields: [tenantId, submissionVersionId], references: [tenantId, id], onDelete: Restrict)
  gradedByTeacher   TeacherProfile    @relation(fields: [tenantId, gradedByTeacherId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, submissionVersionId, revisionNo])
  @@index([tenantId, gradedByTeacherId, gradedAt])
  @@index([tenantId, submissionVersionId, status, publishedAt])
  @@map("grades")
}

// Polymorphic target identity is checked by the executing coordinator, not inferred from UUID alone.
model ApprovalRequest {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  operationType         String         @map("operation_type") @db.Text
  targetType            String         @map("target_type") @db.Text
  targetId              String         @map("target_id") @db.Uuid
  requesterMembershipId String?        @map("requester_membership_id") @db.Uuid
  policyVersionId       String         @map("policy_version_id") @db.Uuid
  status                ApprovalStatus
  reason                String         @db.Text
  payloadSnapshotJson   Json           @map("payload_snapshot_json") @db.JsonB
  correlationId         String         @map("correlation_id") @db.Uuid
  decidedAt             DateTime?      @map("decided_at") @db.Timestamptz(6)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requester                TenantMembership?         @relation("ApprovalRequester", fields: [tenantId, requesterMembershipId], references: [tenantId, id], onDelete: Restrict)
  policyVersion            PolicyVersion             @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  decisions                ApprovalDecision[]
  enrollmentTransfers      EnrollmentTransfer[]      @relation("TransferApproval")
  absenceRequests          AbsenceRequest[]          @relation("AbsenceApproval")
  attendanceCorrections    AttendanceCorrection[]    @relation("AttendanceCorrectionApproval")
  invoiceAdjustments       InvoiceAdjustment[]       @relation("InvoiceAdjustmentApproval")
  paymentReversals         PaymentReversal[]         @relation("PaymentReversalApproval")
  paymentExcessResolutions PaymentExcessResolution[] @relation("PaymentExcessApproval")

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, requesterMembershipId, createdAt])
  @@index([tenantId, correlationId])
  @@index([tenantId, policyVersionId])
  @@map("approval_requests")
}

// Decisions are retained independently of request status; self approval is an audit flag.
model ApprovalDecision {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  approvalRequestId     String               @map("approval_request_id") @db.Uuid
  decidedByMembershipId String               @map("decided_by_membership_id") @db.Uuid
  decision              ApprovalDecisionKind
  reason                String               @db.Text
  decidedAt             DateTime             @map("decided_at") @db.Timestamptz(6)
  selfApproved          Boolean              @default(false) @map("self_approved")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest  @relation(fields: [tenantId, approvalRequestId], references: [tenantId, id], onDelete: Restrict)
  decidedBy       TenantMembership @relation("ApprovalDecider", fields: [tenantId, decidedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, approvalRequestId], map: "r2_one_approval_decision")
  @@index([tenantId, approvalRequestId, decidedAt])
  @@index([tenantId, decidedByMembershipId, decidedAt])
  @@map("approval_decisions")
}

// Persisted execution state; workers claim rows with PostgreSQL row locks and bounded leases.
model AutomationJob {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  jobKind           String              @map("job_kind") @db.Text
  operationKey      String              @map("operation_key") @db.Text
  idempotencyKey    String              @map("idempotency_key") @db.Text
  policyVersionId   String              @map("policy_version_id") @db.Uuid
  triggerEventId    String?             @map("trigger_event_id") @db.Uuid
  actorMembershipId String?             @map("actor_membership_id") @db.Uuid
  correlationId     String              @map("correlation_id") @db.Uuid
  status            AutomationJobStatus
  attemptCount      Int                 @map("attempt_count")
  nextAttemptAt     DateTime            @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner        String?             @map("lease_owner") @db.Text
  leaseUntil        DateTime?           @map("lease_until") @db.Timestamptz(6)
  lastErrorCode     String?             @map("last_error_code") @db.Text
  payloadJson       Json                @map("payload_json") @db.JsonB
  resultJson        Json?               @map("result_json") @db.JsonB
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion     @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  triggerEvent  OutboxEvent?      @relation(fields: [tenantId, triggerEventId], references: [tenantId, id], onDelete: Restrict)
  actor         TenantMembership? @relation("JobActor", fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)
  attempts      JobAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, operationKey])
  @@index([status, nextAttemptAt])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, triggerEventId])
  @@index([tenantId, correlationId])
  @@map("automation_jobs")
}

model JobAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  attemptNo  Int       @map("attempt_no")
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  outcome    String    @db.Text
  errorCode  String?   @map("error_code") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    AutomationJob @relation(fields: [tenantId, jobId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, jobId, attemptNo])
  @@index([tenantId, jobId, startedAt])
  @@map("job_attempts")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  operationType  String    @map("operation_type") @db.Text
  idempotencyKey String    @map("idempotency_key") @db.Text
  requestHash    String    @map("request_hash") @db.Text
  status         String    @db.Text
  resultRefType  String?   @map("result_ref_type") @db.Text
  resultRefId    String?   @map("result_ref_id") @db.Uuid
  resultSnapshot Json?     @map("result_snapshot") @db.JsonB
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, operationType, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, expiresAt])
  @@map("idempotency_records")
}

// Domain mutation and event insertion share one transaction; delivery is at least once.
model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  eventKey      String            @map("event_key") @db.Text
  eventType     String            @map("event_type") @db.Text
  aggregateType String            @map("aggregate_type") @db.Text
  aggregateId   String            @map("aggregate_id") @db.Uuid
  payloadJson   Json              @map("payload_json") @db.JsonB
  occurredAt    DateTime          @map("occurred_at") @db.Timestamptz(6)
  status        OutboxEventStatus
  attemptCount  Int               @map("attempt_count")
  availableAt   DateTime          @map("available_at") @db.Timestamptz(6)
  correlationId String            @map("correlation_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  triggeredJobs AutomationJob[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@unique([tenantId, eventKey])
  @@index([status, availableAt])
  @@index([tenantId, status, availableAt])
  @@index([tenantId, aggregateType, aggregateId])
  @@index([tenantId, correlationId])
  @@map("outbox_events")
}

// P0 inbox kinds are restricted to confirmed schedule changes, assigned work and Manager alerts.
model Notification {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  recipientMembershipId String           @map("recipient_membership_id") @db.Uuid
  outboxEventId         String           @map("outbox_event_id") @db.Uuid
  kind                  NotificationKind
  title                 String           @db.Text
  body                  String           @db.Text
  readAt                DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipient TenantMembership @relation("NotificationRecipient", fields: [tenantId, recipientMembershipId], references: [tenantId, id], onDelete: Restrict)
  event     OutboxEvent      @relation(fields: [tenantId, outboxEventId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, outboxEventId, recipientMembershipId, kind])
  @@index([tenantId, recipientMembershipId, createdAt])
  @@index([tenantId, recipientMembershipId, readAt])
  @@map("notifications")
}

// Append-only trace; before/after payloads must be redacted before insertion and retained >=24 months.
model AuditLog {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  actorUserId       String?        @map("actor_user_id") @db.Uuid
  actorMembershipId String?        @map("actor_membership_id") @db.Uuid
  actorKind         AuditActorKind @map("actor_kind")
  eventType         String         @map("event_type") @db.Text
  entityType        String         @map("entity_type") @db.Text
  entityId          String         @map("entity_id") @db.Uuid
  action            String         @db.Text
  reason            String?        @db.Text
  beforeJson        Json?          @map("before_json") @db.JsonB
  afterJson         Json?          @map("after_json") @db.JsonB
  policyVersionId   String?        @map("policy_version_id") @db.Uuid
  correlationId     String         @map("correlation_id") @db.Uuid
  ipAddress         String?        @map("ip_address") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorUser       User?             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMembership TenantMembership? @relation("AuditMembershipActor", fields: [tenantId, actorMembershipId], references: [tenantId, id], onDelete: Restrict)
  policyVersion   PolicyVersion?    @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, correlationId])
  @@index([tenantId, actorMembershipId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_logs")
}

// R2 immutable calculation generations; applied pointer is scoped to the same run.
model BillingRunGeneration {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  runId                 String                 @map("run_id") @db.Uuid
  studentId             String                 @map("student_id") @db.Uuid
  periodId              String                 @map("period_id") @db.Uuid
  policyVersionId       String                 @map("policy_version_id") @db.Uuid
  generationNo          Int                    @map("generation_no")
  baseGenerationId      String?                @map("base_generation_id") @db.Uuid
  operationKey          String                 @map("operation_key") @db.Text
  requestHash           String                 @map("request_hash") @db.Text
  inputHash             String                 @map("input_hash") @db.Text
  status                String                 @db.Text
  inputSnapshot         Json                   @map("input_snapshot") @db.JsonB
  resultSnapshot        Json                   @map("result_snapshot") @db.JsonB
  reason                String                 @db.Text
  createdByMembershipId String                 @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  run                   BillingRun             @relation("RunGenerations", map: "r2_generation_run_fk", fields: [tenantId, runId, studentId, periodId], references: [tenantId, id, studentId, periodId], onDelete: Restrict, onUpdate: Restrict)
  appliedTo             BillingRun[]           @relation("AppliedGeneration")
  student               StudentProfile         @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  period                BillingPeriod          @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)
  policy                PolicyVersion          @relation(fields: [tenantId, policyVersionId], references: [tenantId, id], onDelete: Restrict)
  createdBy             TenantMembership       @relation(fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  base                  BillingRunGeneration?  @relation("GenerationBase", map: "r2_generation_base_fk", fields: [tenantId, runId, studentId, periodId, baseGenerationId], references: [tenantId, runId, studentId, periodId, id], onDelete: Restrict, onUpdate: Restrict)
  subsequent            BillingRunGeneration[] @relation("GenerationBase")

  @@unique([tenantId, id])
  @@unique([tenantId, runId, studentId, periodId, id])
  @@unique([tenantId, runId, generationNo])
  @@unique([tenantId, operationKey])
  @@map("billing_run_generations")
}

model WalletAccount {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  studentId    String              @map("student_id") @db.Uuid
  balanceVnd   BigInt              @default(0) @map("balance_vnd") @db.BigInt
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student      StudentProfile      @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, studentId])
  @@map("wallet_accounts")
}

model WalletTransaction {
  id                     String                @id @default(uuid()) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  walletId               String                @map("wallet_id") @db.Uuid
  kind                   String                @db.Text
  amountVnd              BigInt                @map("amount_vnd") @db.BigInt
  sourceKey              String                @map("source_key") @db.Text
  operationKey           String                @map("operation_key") @db.Text
  fundingMethod          String?               @map("funding_method") @db.Text
  receiptReference       String?               @map("receipt_reference") @db.Text
  paymentId              String?               @map("payment_id") @db.Uuid
  reversedTopUpId        String?               @map("reversed_top_up_id") @db.Uuid
  reason                 String                @db.Text
  evidence               String                @db.Text
  recordedByMembershipId String                @map("recorded_by_membership_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)

// EduCore P0 — phases 2A–2G. Times are UTC instants; tenant-local display uses Tenant.timezone.
// SQL-only constraints and deferred cross-module relations are tracked in docs/ai/SCHEMA_REVIEW.md.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  ACTIVATION
  PASSWORD_RESET
}

enum AccessScopeKind {
  TENANT
  CLASS
  STUDENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  COMPLETED
  WITHDRAWN
  TRANSFERRED
}

enum ResourceKind {
  TEACHER
  STUDENT
  ROOM
}

enum ResourceUnavailabilityStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum DeliveryMode {
  ONSITE
  ONLINE
}

enum ClassSessionStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionParticipantKind {
  REGULAR
  MAKEUP
}

enum ResourceBookingStatus {
  ACTIVE
  RELEASED
}

enum AttendanceStatus {
  ATTENDED
  EXCUSED
  UNEXCUSED
}

enum PriceScopeKind {
  COURSE
  CLASS
  SESSION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum InvoiceDiscountKind {
  SIBLING
}

enum InvoiceAdjustmentKind {
  AMOUNT
  CANCELLATION
}

enum InvoiceAdjustmentStatus {
  PROPOSED
  APPLIED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  WALLET
}

enum PaymentExcessResolutionStatus {
  PENDING_RESOLUTION
  RESOLVED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionVersionStatus {
  SUBMITTED
}

enum StoredFileStatus {
  STAGING
  READY
  ORPHANED
}

enum GradeStatus {
  DRAFT
  PUBLISHED
}

enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  COMPLETED
  FAILED
}

enum ApprovalDecisionKind {
  APPROVE
  REJECT
  REQUEST_INFO
}

enum AutomationJobStatus {
  READY
  RUNNING
  NEEDS_INFORMATION
  PENDING_APPROVAL
  COMPLETED
  FAILED
}

enum OutboxEventStatus {
  NEW
  PROCESSING
  DONE
  FAILED
}

enum NotificationKind {
  SCHEDULE_CHANGED
  ASSIGNMENT_PUBLISHED
  ADMIN_ALERT
}

enum AuditActorKind {
  USER
  WORKER
  OPERATOR
}

model Tenant {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.Text
  name             String    @db.Text
  timezone         String    @default("Asia/Ho_Chi_Minh") @db.Text
  timezoneFrozenAt DateTime? @map("timezone_frozen_at") @db.Timestamptz(6)
  status           String    @db.Text
  activatedAt      DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  policyVersions               PolicyVersion[]
  authSessions                 AuthSession[]
  memberships                  TenantMembership[]
  roles                        Role[]
  rolePermissions              RolePermission[]
  membershipRoles              MembershipRole[]
  accessScopes                 AccessScope[]
  teacherProfiles              TeacherProfile[]
  studentProfiles              StudentProfile[]
  subjects                     Subject[]
  levels                       Level[]
  courses                      Course[]
  classes                      Class[]
  teacherCompetencies          TeacherCompetency[]
  classTeacherAssignments      ClassTeacherAssignment[]
  enrollments                  Enrollment[]
  enrollmentTransfers          EnrollmentTransfer[]
  parentStudentLinks           ParentStudentLink[]
  verifiedSiblingRelationships VerifiedSiblingRelationship[]
  rooms                        Room[]
  schedulableResources         SchedulableResource[]
  resourceUnavailability       ResourceUnavailability[]
  scheduleSeries               ScheduleSeries[]
  classSessions                ClassSession[]
  sessionParticipants          SessionParticipant[]
  resourceBookings             ResourceBooking[]
  absenceRequests              AbsenceRequest[]
  attendanceFinalizations      AttendanceFinalization[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrections        AttendanceCorrection[]
  priceRules                   PriceRule[]
  billingPeriods               BillingPeriod[]
  billingRuns                  BillingRun[]
  invoices                     Invoice[]
  invoiceLines                 InvoiceLine[]
  invoiceDiscounts             InvoiceDiscount[]
  invoicedParticipationClaims  InvoicedParticipationClaim[]
  invoiceAdjustments           InvoiceAdjustment[]
  payments                     Payment[]
  paymentReversals             PaymentReversal[]
  receivableAllocations        ReceivableAllocation[]
  paymentExcessResolutions     PaymentExcessResolution[]
  assignments                  Assignment[]
  assignmentRecipients         AssignmentRecipient[]
  submissions                  Submission[]
  submissionVersions           SubmissionVersion[]
  storedFiles                  StoredFile[]
  submissionFiles              SubmissionFile[]
  grades                       Grade[]
  approvalRequests             ApprovalRequest[]
  approvalDecisions            ApprovalDecision[]
  automationJobs               AutomationJob[]
  jobAttempts                  JobAttempt[]
  idempotencyRecords           IdempotencyRecord[]
  outboxEvents                 OutboxEvent[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  billingGenerations           BillingRunGeneration[]
  walletAccounts               WalletAccount[]
  walletTransactions           WalletTransaction[]
  invoiceCounters              InvoiceNumberCounter[]

  @@map("tenants")
}

// Approved P0 immutable policy snapshots; policy-management UI remains P1.
model PolicyVersion {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  versionCode           String    @map("version_code") @db.Text
  effectiveFrom         DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(6)
  configSnapshot        Json      @map("config_snapshot") @db.JsonB
  contentHash           String    @map("content_hash") @db.Text
  createdByMembershipId String?   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy        TenantMembership?      @relation("PolicyVersionCreator", fields: [tenantId, createdByMembershipId], references: [tenantId, id], onDelete: Restrict)
  classSessions    ClassSession[]
  priceRules       PriceRule[]
  billingRuns      BillingRun[]
  invoices         Invoice[]
  approvalRequests ApprovalRequest[]
  automationJobs   AutomationJob[]
  auditLogs        AuditLog[]
  generations      BillingRunGeneration[]
  absenceRequests  AbsenceRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, versionCode])
  @@index([tenantId, effectiveFrom])
  @@map("policy_versions")
}

// Global identity: a user can have separate memberships in multiple tenants.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  emailNormalized String     @unique @map("email_normalized") @db.Text
  displayName     String     @map("display_name") @db.Text
  status          UserStatus @default(PENDING_ACTIVATION)
  activatedAt     DateTime?  @map("activated_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential  Credential?
  auditLogs   AuditLog[]
  sessions    AuthSession[]
  otps        PasswordResetOtp[]
  memberships TenantMembership[]

  @@map("users")
}

model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.Text
  passwordChangedAt DateTime  @map("password_changed_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  activeTenantId   String?   @map("active_tenant_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.Text
  issuedAt         DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeTenant        Tenant?              @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)
  r2PrincipalBindings R2PrincipalBinding[]

  @@index([userId, revokedAt, expiresAt])
  @@index([activeTenantId])
  @@map("auth_sessions")
}

// Historical table name is retained for activation and password-reset OTPs.
model PasswordResetOtp {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  purpose      OtpPurpose
  otpHash      String     @map("otp_hash") @db.Text
  requestedAt  DateTime   @default(now()) @map("requested_at") @db.Timestamptz(6)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt   DateTime?  @map("consumed_at") @db.Timestamptz(6)
  attemptCount Int        @default(0) @map("attempt_count")
  maxAttempts  Int        @map("max_attempts")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, consumedAt, expiresAt])
  @@map("password_reset_otps")
}

model TenantMembership {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  status    String    @db.Text
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                           User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  policyVersionsCreated          PolicyVersion[]               @relation("PolicyVersionCreator")
  roleAssignments                MembershipRole[]              @relation("MembershipRoleSubject")
  rolesAssigned                  MembershipRole[]              @relation("MembershipRoleAssigner")
  teacherProfile                 TeacherProfile?               @relation("TeacherMembership")
  studentProfile                 StudentProfile?               @relation("StudentMembership")
  classTeacherAssignments        ClassTeacherAssignment[]      @relation("ClassTeacherAssigner")
  enrollmentsCreated             Enrollment[]                  @relation("EnrollmentCreator")
  transfersRequested             EnrollmentTransfer[]          @relation("TransferRequester")
  transfersConfirmed             EnrollmentTransfer[]          @relation("TransferConfirmer")
  parentLinks                    ParentStudentLink[]           @relation("ParentLinkParent")
  parentLinksVerified            ParentStudentLink[]           @relation("ParentLinkVerifier")
  siblingRelationshipsVerified   VerifiedSiblingRelationship[] @relation("SiblingVerifier")
  resourceUnavailabilityCreated  ResourceUnavailability[]
  absenceRequestsSubmitted       AbsenceRequest[]              @relation("AbsenceRequester")
  absenceRequestsApproved        AbsenceRequest[]              @relation("AbsenceApprover")
  attendanceFinalizations        AttendanceFinalization[]
  attendanceRecordsEntered       AttendanceRecord[]
  attendanceCorrectionsRequested AttendanceCorrection[]        @relation("AttendanceCorrectionRequester")
  attendanceCorrectionsApproved  AttendanceCorrection[]        @relation("AttendanceCorrectionApprover")
  priceRulesCreated              PriceRule[]                   @relation("PriceRuleCreator")
  billingRunsRequested           BillingRun[]                  @relation("BillingRunRequester")
  invoicesIssued                 Invoice[]                     @relation("InvoiceIssuer")
  invoiceAdjustmentsApplied      InvoiceAdjustment[]           @relation("AdjustmentApplier")
  paymentsRecorded               Payment[]                     @relation("PaymentRecorder")
  paymentReversalsPerformed      PaymentReversal[]             @relation("PaymentReverser")
  filesUploaded                  StoredFile[]                  @relation("FileUploader")
  approvalRequestsMade           ApprovalRequest[]             @relation("ApprovalRequester")
  approvalDecisionsMade          ApprovalDecision[]            @relation("ApprovalDecider")
  automationJobsActed            AutomationJob[]               @relation("JobActor")
  notificationsReceived          Notification[]                @relation("NotificationRecipient")
  auditLogsActed                 AuditLog[]                    @relation("AuditMembershipActor")
  generations                    BillingRunGeneration[]
  walletTransactions             WalletTransaction[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String   @db.Text
  name           String   @db.Text
  isSystemSeeded Boolean  @default(false) @map("is_system_seeded")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.Text
  description String  @db.Text
  isSensitive Boolean @default(false) @map("is_sensitive")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Keep revoked grants for history; active-grant uniqueness requires a partial SQL index.
model MembershipRole {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  membershipId           String    @map("membership_id") @db.Uuid
  roleId                 String    @map("role_id") @db.Uuid
  assignedByMembershipId String    @map("assigned_by_membership_id") @db.Uuid
  assignedAt             DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership   TenantMembership @relation("MembershipRoleSubject", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  role         Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  assignedBy   TenantMembership @relation("MembershipRoleAssigner", fields: [tenantId, assignedByMembershipId], references: [tenantId, id], onDelete: Restrict)
  accessScopes AccessScope[]

  @@unique([tenantId, id])
  @@index([tenantId, membershipId, revokedAt])
  @@index([tenantId, roleId])
  @@index([tenantId, assignedByMembershipId])
  @@map("membership_roles")
}

model AccessScope {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  membershipRoleId String          @map("membership_role_id") @db.Uuid
  scopeKind        AccessScopeKind @map("scope_kind")
  classId          String?         @map("class_id") @db.Uuid
  studentId        String?         @map("student_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membershipRole MembershipRole  @relation(fields: [tenantId, membershipRoleId], references: [tenantId, id], onDelete: Restrict)
  class          Class?          @relation("ClassAccessScope", fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  student        StudentProfile? @relation("StudentAccessScope", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipRoleId, scopeKind])
  @@index([tenantId, classId])
  @@index([tenantId, studentId])
  @@map("access_scopes")
}

// Academic profiles can exist without a login; a linked membership must share the tenant.
model TeacherProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String?  @map("membership_id") @db.Uuid
  teacherCode  String   @map("teacher_code") @db.Text
  fullName     String   @map("full_name") @db.Text
  contact      String?  @db.Text
  status       String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership              TenantMembership?        @relation("TeacherMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  competencies            TeacherCompetency[]
  classTeacherAssignments ClassTeacherAssignment[]
  schedulableResource     SchedulableResource?
  classSessions           ClassSession[]
  assignmentsCreated      Assignment[]
  gradesGiven             Grade[]

  @@unique([tenantId, id])
  @@unique([tenantId, teacherCode])
  @@unique([tenantId, membershipId])
  @@map("teacher_profiles")
}

model StudentProfile {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String?   @map("membership_id") @db.Uuid
  studentCode  String    @map("student_code") @db.Text
  fullName     String    @map("full_name") @db.Text
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  status       String    @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership            TenantMembership?             @relation("StudentMembership", fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  enrollments           Enrollment[]
  parentLinks           ParentStudentLink[]
  siblingRelationshipsA VerifiedSiblingRelationship[] @relation("SiblingStudentA")
  siblingRelationshipsB VerifiedSiblingRelationship[] @relation("SiblingStudentB")
  accessScopes          AccessScope[]                 @relation("StudentAccessScope")
  schedulableResource   SchedulableResource?
  sessionParticipants   SessionParticipant[]
  billingRuns           BillingRun[]
  invoices              Invoice[]
  assignmentRecipients  AssignmentRecipient[]
  billingGenerations    BillingRunGeneration[]
  walletAccount         WalletAccount?

  @@unique([tenantId, id])
  @@unique([tenantId, studentCode])
  @@unique([tenantId, membershipId])
  @@map("student_profiles")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.Text
  name      String   @db.Text
  active    Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courses             Course[]
  teacherCompetencies TeacherCompetency[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("subjects")
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.Text
  name      String   @db.Text
  sortOrder Int      @map("sort_order")
  active    Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courses             Course[]
  teacherCompetencies TeacherCompetency[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("levels")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.Text
  name        String   @db.Text
  subjectId   String   @map("subject_id") @db.Uuid
  levelId     String   @map("level_id") @db.Uuid
  status      String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subject    Subject     @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  level      Level       @relation(fields: [tenantId, levelId], references: [tenantId, id], onDelete: Restrict)
  classes    Class[]
  priceRules PriceRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, subjectId, levelId])
  @@map("courses")
}

model Class {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String    @db.Text
  name      String    @db.Text
  courseId  String    @map("course_id") @db.Uuid
  capacity  Int
  status    String    @db.Text
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course             Course                   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  teacherAssignments ClassTeacherAssignment[]
  enrollments        Enrollment[]
  targetTransfers    EnrollmentTransfer[]
  accessScopes       AccessScope[]            @relation("ClassAccessScope")
  scheduleSeries     ScheduleSeries[]
  classSessions      ClassSession[]
  priceRules         PriceRule[]
  assignments        Assignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, courseId])
  @@map("classes")
}

model TeacherCompetency {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  teacherId  String    @map("teacher_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  levelId    String    @map("level_id") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teacher TeacherProfile @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  subject Subject        @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  level   Level          @relation(fields: [tenantId, levelId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, teacherId, subjectId, levelId])
  @@index([tenantId, subjectId, levelId])
  @@map("teacher_competencies")
}

model ClassTeacherAssignment {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  classId                String    @map("class_id") @db.Uuid
  teacherId              String    @map("teacher_id") @db.Uuid
  roleKind               String    @map("role_kind") @db.Text
  validFrom              DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo                DateTime? @map("valid_to") @db.Timestamptz(6)
  assignedByMembershipId String    @map("assigned_by_membership_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  class      Class            @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict)
  teacher    TeacherProfile   @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict)
  assignedBy TenantMembership @relation("ClassTeacherAssigner", fields: [tenantId, assignedByMembershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])

# Node 24.12+ (Node 24). Copy to .env locally; fill blank values privately.
NODE_ENV=development
PORT=3000
# Prisma CLI ONLY: migration LOGIN on an owner-approved LOCAL development DB.
DATABASE_URL=
# Separate restricted LOGINs, members of educore_r4_auth / educore_r4_api.
# NEVER use DATABASE_URL as a runtime fallback. Never migrate through these.
R4_AUTH_URL=
R4_API_URL=
# Independent random secrets, each at least 32 bytes. No sample shared key.
R4_JWT_SECRET=
R4_OTP_PEPPER=
R4_JWT_ISSUER=educore-local
R4_JWT_AUDIENCE=educore-web-local
R4_WEB_ORIGINS=http://localhost:5173
# No external email or public OTP-capture endpoint in the local default.
R4_OTP_MODE=unavailable
# Optional: required only when enabled. Restricted educore_r4_worker LOGIN.
R4_WORKER_ENABLED=0
R4_WORKER_URL=
# Dedicated absolute directory, owned only by the API OS identity. Not public.
R5_PRIVATE_STORAGE_ROOT=
# Required only for R4_OTP_MODE=smtp. 465 TLS or 587 required STARTTLS.
R4_SMTP_HOST=
R4_SMTP_PORT=465
R4_SMTP_USER=
R4_SMTP_PASSWORD=
R4_SMTP_FROM=
# Operator CLI ONLY (never supplied to HTTP runtime):
# R4_OPERATOR_URL=
